# ---- REQUIRED ----
# Free key from https://console.groq.com  (Keys -> Create API Key)
GROQ_API_KEY=your_groq_key_here

# ---- SERVER ----
# Back4app Containers: set this to 8080 and set the same port in App Settings.
PORT=8080

# Comma-separated list of allowed frontend origins.
# Use * ONLY for local testing. In production put your Netlify URL here.
ALLOWED_ORIGINS=http://localhost:5500,https://your-site.netlify.app

# ---- PIPELINE TUNING (safe defaults for small containers) ----
# Max source height to download. 720 is much lighter on RAM/CPU than 1080.
MAX_SOURCE_HEIGHT=720
# Output vertical size. 720x1280 encodes ~2x faster than 1080x1920.
CLIP_WIDTH=720
CLIP_HEIGHT=1280
# How many clips to produce per video.
NUM_CLIPS=3
# Clip length bounds in seconds.
MIN_CLIP_SECONDS=20
MAX_CLIP_SECONDS=60
# Refuse videos longer than this (protects small containers from OOM).
MAX_VIDEO_MINUTES=30
# Delete source video/audio after processing to free disk.
CLEANUP_SOURCE=true
# Delete finished clips after this many minutes (0 = never).
CLIP_TTL_MINUTES=120

# ---- OPTIONAL ----
# Groq LLM used to pick the highlights.
GROQ_MODEL=llama-3.3-70b-versatile
# Only needed for LOCAL Windows runs where yt-dlp isn't on PATH.
# Leave EMPTY in production - Docker installs yt-dlp to /usr/local/bin.
# YT_DLP_PATH=
# If YouTube blocks the datacenter IP, export cookies.txt and paste the
# whole file contents into this variable (see README "bot check" section).
# YTDLP_COOKIES=
